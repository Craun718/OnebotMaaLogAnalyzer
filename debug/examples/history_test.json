{
  "name": "分析历史 — 归档 / 周期清理 / 跨天追问",
  "description": "验证历史记录归档（日志包 + 追问消息 ID）、按周期清理过期记录、git 仓库缓存不受影响，以及内存会话失效后仍可通过历史归档继续追问。",
  "setup": {
    "configs": {
      "历史组": {
        "listen_groups": [
          "333333"
        ],
        "notify_group": "333333",
        "settings": {
          "send_progress_message": false,
          "followup_enabled": true,
          "followup_window_minutes": 0,
          "history_enabled": true,
          "history_period_hours": 24,
          "history_keep_periods": 2
        },
        "commands": {
          "prefix": "/maa",
          "owners": [
            "90001"
          ],
          "write_level": 2,
          "read_level": 0,
          "followup_level": 0
        },
        "project": {
          "name": "MaaXXX"
        }
      }
    },
    "files": {
      "333333": [
        {
          "file_name": "MaaXXX-logs-20260101-120000.zip",
          "file_id": "fid_hist",
          "size": 2048
        }
      ]
    },
    "create_files": [
      "repos/sentinel/.keep"
    ],
    "history": {
      "config": "历史组",
      "reset": true,
      "records": [
        {
          "file_name": "MaaXXX-logs-old.zip",
          "group_id": "333333",
          "age_hours": 60,
          "message_ids": [
            "200001"
          ],
          "context": "旧日志的追问上下文",
          "report": "旧日志分析报告"
        },
        {
          "file_name": "MaaXXX-logs-recent.zip",
          "group_id": "333333",
          "age_hours": 10,
          "message_ids": [
            "200002"
          ],
          "context": "近期日志的追问上下文（结论：StartUp 失败）",
          "report": "近期日志分析报告（结论：配置缺失）"
        }
      ]
    }
  },
  "scenarios": [
    {
      "name": "历史 — 查看归档统计（清理前 2 条）",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 333333,
        "user_id": 55555,
        "raw_message": "/maa history",
        "message": "/maa history",
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": [
          "分析历史归档",
          "记录条数：2",
          "保留 2 个周期",
          "git 仓库缓存不属于历史"
        ],
        "history_count": 2
      }
    },
    {
      "name": "历史 — 周期清理删除过期记录，保留近期记录",
      "history_cleanup": {
        "config": "历史组",
        "period_hours": 24,
        "keep_periods": 2
      },
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 999999,
        "user_id": 55555,
        "raw_message": "无关发言",
        "message": "无关发言",
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "api_count": 0,
        "history_count": 1,
        "history_zips": "MaaXXX-logs-recent.zip",
        "history_no_zips": "MaaXXX-logs-old.zip",
        "history_message_ids": "200002"
      }
    },
    {
      "name": "历史 — git 仓库缓存不被清理",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 999999,
        "user_id": 55555,
        "raw_message": "无关发言",
        "message": "无关发言",
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "api_count": 0,
        "files_exist": "repos/sentinel/.keep"
      }
    },
    {
      "name": "历史 — 内存会话失效后仍可引用历史记录追问",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 333333,
        "user_id": 55555,
        "raw_message": "这条日志到底什么问题？",
        "message": [
          {
            "type": "reply",
            "data": {
              "id": "200002"
            }
          },
          {
            "type": "text",
            "data": {
              "text": "这条日志到底什么问题？"
            }
          }
        ],
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "结论",
        "api_actions_include": "send_group_msg"
      }
    },
    {
      "name": "历史 — 已被清理的旧记录无法再追问",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 333333,
        "user_id": 55555,
        "raw_message": "旧日志呢？",
        "message": [
          {
            "type": "reply",
            "data": {
              "id": "200001"
            }
          },
          {
            "type": "text",
            "data": {
              "text": "旧日志呢？"
            }
          }
        ],
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "api_count": 0
      }
    },
    {
      "name": "历史 — 普通成员执行 clean 被拒绝",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 333333,
        "user_id": 55555,
        "raw_message": "/maa history clean",
        "message": "/maa history clean",
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "权限不足",
        "history_count": 1
      }
    },
    {
      "name": "历史 — 超管可清空全部历史",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 333333,
        "user_id": 90001,
        "raw_message": "/maa history purge",
        "message": "/maa history purge",
        "sender": {
          "user_id": 90001,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": [
          "已清空分析历史",
          "git 仓库缓存不受影响"
        ],
        "history_count": 0,
        "files_exist": "repos/sentinel/.keep"
      }
    },
    {
      "name": "历史 — 上传分析后自动归档日志包与消息 ID",
      "event": {
        "post_type": "notice",
        "notice_type": "group_upload",
        "group_id": 333333,
        "user_id": 90001,
        "file": {
          "id": "fid_hist",
          "name": "MaaXXX-logs-20260101-120000.zip",
          "size": 2048
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "MaaXXX 日志分析结果",
        "history_count": 1,
        "history_zips": "MaaXXX-logs-20260101-120000.zip",
        "history_message_ids": "$LAST_BOT_MSG"
      }
    },
    {
      "name": "历史 — 内存会话已清空，引用历史消息仍可追问（跨天）",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 333333,
        "user_id": 55555,
        "raw_message": "这个日志还有别的问题吗？",
        "message": [
          {
            "type": "reply",
            "data": {
              "id": "$LAST_BOT_MSG"
            }
          },
          {
            "type": "text",
            "data": {
              "text": "这个日志还有别的问题吗？"
            }
          }
        ],
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "结论",
        "api_actions_include": "send_group_msg"
      }
    }
  ]
}
