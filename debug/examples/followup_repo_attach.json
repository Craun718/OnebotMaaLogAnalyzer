{
  "name": "追问的仓库附件 — 重启后 @项目 附件仍可取到",
  "description": "inject 模式下 @项目 附件依赖 RepoProvider；重启后 provider 内存缓存为空，若不复用/重建则附件静默丢失（只在末尾出现「未找到」备注）。本套件锁定重启后 @项目 附件仍能正常取出并发送。",
  "setup": {
    "mock_repo": {
      "assets/resource/image/Start2.png": "fake-png-bytes",
      "assets/resource/pipeline/PVP.json": {
        "PVP_Click:StartBattle": {
          "desc": "点击开始战斗",
          "recognition": {
            "type": "TemplateMatch",
            "param": {
              "template": [
                "UI/Combat/Start2.png"
              ],
              "threshold": 0.7
            }
          }
        }
      }
    },
    "model_report": "结论：\n（调试模式模拟输出）PVP 节点阈值偏低。\n\n下面这张模板图取自项目仓库：\n[附图@项目: assets/resource/image/Start2.png]\n可以看到模板内容。\n\n对应的节点定义如下：\n[附件@项目: assets/resource/pipeline/PVP.json]\n其中 threshold 为 0.7。",
    "configs": {
      "注入组": {
        "listen_groups": [
          "666666"
        ],
        "notify_group": "666666",
        "settings": {
          "send_progress_message": false,
          "followup_enabled": true,
          "followup_window_minutes": 0,
          "history_enabled": true,
          "history_period_hours": 24,
          "history_keep_periods": 2,
          "send_images": true,
          "max_report_images": 2,
          "send_repo_images": true,
          "send_files": true,
          "max_report_files": 2
        },
        "commands": {
          "prefix": "/maa",
          "owners": [
            "90001"
          ],
          "read_level": 0,
          "write_level": 2,
          "followup_level": 0
        },
        "project": {
          "repo": {
            "enabled": true,
            "mode": "inject"
          },
          "name": "MaaXXX"
        }
      }
    },
    "files": {
      "666666": [
        {
          "file_name": "MaaXXX-logs-20260101-120000.zip",
          "file_id": "fid_inj",
          "size": 2048
        }
      ]
    },
    "history": {
      "config": "注入组",
      "reset": true
    }
  },
  "scenarios": [
    {
      "name": "分析 — @项目 附件正常发送（基线）",
      "event": {
        "post_type": "notice",
        "notice_type": "group_upload",
        "group_id": 666666,
        "user_id": 90001,
        "file": {
          "id": "fid_inj",
          "name": "MaaXXX-logs-20260101-120000.zip",
          "size": 2048
        }
      },
      "capture": {
        "analysis_msg": "LAST_BOT_MSG"
      },
      "assert": {
        "no_error": true,
        "api_actions_include": [
          "send_group_msg",
          "upload_group_file"
        ],
        "api_segments_include": "image",
        "reply_not_contains": "未找到"
      }
    },
    {
      "name": "重启后追问 — @项目 附件仍可取到（关键回归）",
      "restart": true,
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 666666,
        "user_id": 55555,
        "raw_message": "把模板图和节点定义发我看看",
        "message": [
          {
            "type": "reply",
            "data": {
              "id": "$analysis_msg"
            }
          },
          {
            "type": "text",
            "data": {
              "text": "把模板图和节点定义发我看看"
            }
          }
        ],
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "结论",
        "api_actions_include": [
          "send_group_msg",
          "upload_group_file"
        ],
        "api_segments_include": "image",
        "reply_not_contains": "未找到"
      }
    },
    {
      "name": "重启后追问 — 附件指令未泄露为文字",
      "restart": true,
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 666666,
        "user_id": 55555,
        "raw_message": "再发一次",
        "message": [
          {
            "type": "reply",
            "data": {
              "id": "$analysis_msg"
            }
          },
          {
            "type": "text",
            "data": {
              "text": "再发一次"
            }
          }
        ],
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_not_contains": [
          "[附图@项目",
          "[附件@项目",
          "未找到"
        ]
      }
    }
  ]
}
