{
  "name": "追问工具循环 — 模型只检索不输出正文时仍需给出回答",
  "description": "复现线上问题：追问时模型连续调用工具直到轮次上限、全程没有输出过正文，旧实现因 last_text 为空而直接返回 None，Bot 回复「本次追问没有获得有效回复」。修复后应在轮次用尽时要求模型收敛作答，即便模型不配合也要给出可读的兜底回复。",
  "setup": {
    "llm_tool_behavior": "always",
    "mock_repo": {
      "assets/resource/pipeline/StartUp.json": {
        "StartUp": {
          "desc": "启动游戏并等待主界面",
          "recognition": {
            "type": "OCR",
            "param": {
              "expected": [
                "开始"
              ],
              "threshold": 0.9
            }
          }
        }
      }
    },
    "configs": {
      "循环组": {
        "listen_groups": [
          "777777"
        ],
        "notify_group": "777777",
        "settings": {
          "send_progress_message": false,
          "followup_enabled": true,
          "followup_window_minutes": 0,
          "history_enabled": true,
          "history_period_hours": 24,
          "history_keep_periods": 2
        },
        "commands": {
          "prefix": "/maa",
          "owners": [
            "90001"
          ],
          "read_level": 0,
          "write_level": 2,
          "followup_level": 0
        },
        "project": {
          "repo": {
            "enabled": true,
            "mode": "agent",
            "max_tool_rounds": 3,
            "max_tool_calls_per_round": 2
          },
          "name": "MaaXXX"
        }
      }
    },
    "files": {
      "777777": [
        {
          "file_name": "MaaXXX-logs-20260101-120000.zip",
          "file_id": "fid_loop",
          "size": 2048
        }
      ]
    },
    "history": {
      "config": "循环组",
      "reset": true
    }
  },
  "scenarios": [
    {
      "name": "分析 — 模型检索到上限后仍给出报告",
      "event": {
        "post_type": "notice",
        "notice_type": "group_upload",
        "group_id": 777777,
        "user_id": 90001,
        "file": {
          "id": "fid_loop",
          "name": "MaaXXX-logs-20260101-120000.zip",
          "size": 2048
        }
      },
      "capture": {
        "analysis_msg": "LAST_BOT_MSG"
      },
      "assert": {
        "no_error": true,
        "reply_contains": "MaaXXX 日志分析结果",
        "history_count": 1
      }
    },
    {
      "name": "追问 — 模型只检索不输出正文，仍须给出回答（关键回归）",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 777777,
        "user_id": 55555,
        "raw_message": "看看可能是哪几个节点的问题",
        "message": [
          {
            "type": "reply",
            "data": {
              "id": "$analysis_msg"
            }
          },
          {
            "type": "text",
            "data": {
              "text": "看看可能是哪几个节点的问题"
            }
          }
        ],
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "api_actions_include": "send_group_msg",
        "reply_not_contains": "没有获得有效回复",
        "reply_contains": "结论"
      }
    },
    {
      "name": "追问 — 工具确实被调用过（确认走的是工具循环）",
      "preserve_followup": true,
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 777777,
        "user_id": 55555,
        "raw_message": "再确认一次",
        "message": [
          {
            "type": "reply",
            "data": {
              "id": "$analysis_msg"
            }
          },
          {
            "type": "text",
            "data": {
              "text": "再确认一次"
            }
          }
        ],
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_not_contains": "没有获得有效回复",
        "tools_include": "log_search"
      }
    }
  ]
}
