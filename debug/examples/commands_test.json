{
  "name": "指令与追问答疑 — 配置管理 / 附图 / 会话延续",
  "description": "验证 /maa 指令的权限与读写、结果附图、分析后追问答疑会话。",
  "setup": {
    "configs": {
      "运维组": {
        "listen_groups": [
          "111111"
        ],
        "notify_group": "111111",
        "settings": {
          "send_progress_message": false
        },
        "commands": {
          "prefix": "/maa",
          "owners": [
            "90001"
          ],
          "admins": [
            "90002"
          ],
          "write_level": 2,
          "read_level": 0
        },
        "project": {
          "name": "MaaXXX"
        }
      },
      "宽松组": {
        "listen_groups": [
          "222222"
        ],
        "notify_group": "222222",
        "settings": {
          "send_progress_message": false
        },
        "commands": {
          "prefix": "/maa",
          "owners": [
            "90001"
          ],
          "write_level": 1,
          "read_level": 0
        },
        "project": {
          "name": "MaaXXX"
        }
      }
    },
    "files": {
      "111111": [
        {
          "file_name": "MaaXXX-logs-20260101-120000.zip",
          "file_id": "fid_ops",
          "size": 2048,
          "modify_time": 1767225600
        }
      ]
    }
  },
  "scenarios": [
    {
      "name": "指令 — 普通成员可查看 status",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 55555,
        "raw_message": "/maa status",
        "message": "/maa status",
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "配置名：运维组"
      }
    },
    {
      "name": "指令 — 普通成员改配置被拒绝",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 55555,
        "raw_message": "/maa set max_log_files 3",
        "message": "/maa set max_log_files 3",
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "权限不足"
      }
    },
    {
      "name": "指令 — 群管理员在 write_level=2 下仍被拒绝（默认保守）",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 90002,
        "raw_message": "/maa set max_log_files 3",
        "message": "/maa set max_log_files 3",
        "sender": {
          "user_id": 90002,
          "role": "admin"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "权限不足"
      }
    },
    {
      "name": "指令 — write_level=1 时群管理员可改配置",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 222222,
        "user_id": 77777,
        "raw_message": "/maa set max_log_files 3",
        "message": "/maa set max_log_files 3",
        "sender": {
          "user_id": 77777,
          "role": "admin"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "已设置"
      }
    },
    {
      "name": "指令 — write_level=1 时普通成员仍被拒绝",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 222222,
        "user_id": 55555,
        "raw_message": "/maa set max_log_files 3",
        "message": "/maa set max_log_files 3",
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "权限不足"
      }
    },
    {
      "name": "指令 — 超管可改配置（按 owners 列表）",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 90001,
        "raw_message": "/maa set max_log_files 5",
        "message": "/maa set max_log_files 5",
        "sender": {
          "user_id": 90001,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "已设置"
      }
    },
    {
      "name": "指令 — get 可看到刚改的值",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 90001,
        "raw_message": "/maa get",
        "message": "/maa get",
        "sender": {
          "user_id": 90001,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "max_log_files = 5"
      }
    },
    {
      "name": "指令 — 值类型非法被拒绝",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 90001,
        "raw_message": "/maa set max_log_files abc",
        "message": "/maa set max_log_files abc",
        "sender": {
          "user_id": 90001,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "值无效"
      }
    },
    {
      "name": "指令 — repo mode 切换为 agent",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 90001,
        "raw_message": "/maa repo mode agent",
        "message": "/maa repo mode agent",
        "sender": {
          "user_id": 90001,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "已设置"
      }
    },
    {
      "name": "指令 — repo mode 非法值被拒绝",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 90001,
        "raw_message": "/maa repo mode banana",
        "message": "/maa repo mode banana",
        "sender": {
          "user_id": 90001,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "只能是 inject 或 agent"
      }
    },
    {
      "name": "指令 — repo url 可设置镜像地址",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 90001,
        "raw_message": "/maa repo url https://gitee.com/mirror/MaaXXX.git",
        "message": "/maa repo url https://gitee.com/mirror/MaaXXX.git",
        "sender": {
          "user_id": 90001,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "gitee.com/mirror/MaaXXX.git"
      }
    },
    {
      "name": "指令 — 停用配置后不再分析日志包",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 90001,
        "raw_message": "/maa disable",
        "message": "/maa disable",
        "sender": {
          "user_id": 90001,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "已停用"
      }
    },
    {
      "name": "停用后 — 上传日志包不响应",
      "event": {
        "post_type": "notice",
        "notice_type": "group_upload",
        "group_id": 111111,
        "user_id": 90001,
        "file": {
          "id": "fid_ops",
          "name": "MaaXXX-logs-20260101-120000.zip",
          "size": 2048
        }
      },
      "assert": {
        "no_error": true,
        "api_count": 0
      }
    },
    {
      "name": "指令 — 重新启用配置",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 90001,
        "raw_message": "/maa enable",
        "message": "/maa enable",
        "sender": {
          "user_id": 90001,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "已启用"
      }
    },
    {
      "name": "上传日志包 — 分析并附图（模型声明附图）",
      "event": {
        "post_type": "notice",
        "notice_type": "group_upload",
        "group_id": 111111,
        "user_id": 90001,
        "file": {
          "id": "fid_ops",
          "name": "MaaXXX-logs-20260101-120000.zip",
          "size": 2048
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "MaaXXX 日志分析结果",
        "reply_not_contains": "[附图",
        "api_actions_include": "send_group_msg",
        "api_segments_include": "image"
      }
    },
    {
      "name": "附件 — 非图片附件以群文件形式发送（不泄露指令）",
      "event": {
        "post_type": "notice",
        "notice_type": "group_upload",
        "group_id": 111111,
        "user_id": 90001,
        "file": {
          "id": "fid_ops",
          "name": "MaaXXX-logs-20260101-120000.zip",
          "size": 2048
        }
      },
      "assert": {
        "no_error": true,
        "reply_not_contains": [
          "[附件",
          "[文件"
        ],
        "api_actions_include": "upload_group_file",
        "api_segments_include": "image"
      }
    },
    {
      "name": "附件 — 行内附图插在文字中间（图前有文字）",
      "event": {
        "post_type": "notice",
        "notice_type": "group_upload",
        "group_id": 111111,
        "user_id": 90001,
        "file": {
          "id": "fid_ops",
          "name": "MaaXXX-logs-20260101-120000.zip",
          "size": 2048
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": [
          "下面这张错误截图可以直接看出界面停在哪里",
          "可以看到界面没有进入主界面"
        ],
        "reply_not_contains": "[附图"
      },
      "capture": {
        "analysis_msg": "LAST_BOT_MSG"
      }
    },
    {
      "name": "追问 — 未引用消息的发言不响应",
      "preserve_followup": true,
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 55555,
        "raw_message": "为什么 StartUp 任务失败了？",
        "message": "为什么 StartUp 任务失败了？",
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "api_count": 0
      }
    },
    {
      "name": "追问 — 引用 Bot 分析结果消息才响应",
      "preserve_followup": true,
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 55555,
        "raw_message": "为什么 StartUp 任务失败了？",
        "message": [
          {
            "type": "reply",
            "data": {
              "id": "$analysis_msg"
            }
          },
          {
            "type": "text",
            "data": {
              "text": "为什么 StartUp 任务失败了？"
            }
          }
        ],
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "结论"
      }
    },
    {
      "name": "追问 — 回复中的附图指令不泄露为文字（回归）",
      "preserve_followup": true,
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 55555,
        "raw_message": "能附上相关截图吗？",
        "message": [
          {
            "type": "reply",
            "data": {
              "id": "$analysis_msg"
            }
          },
          {
            "type": "text",
            "data": {
              "text": "能附上相关截图吗？"
            }
          }
        ],
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "结论",
        "reply_not_contains": [
          "[附图",
          "[附件"
        ],
        "api_segments_include": "image"
      },
      "capture": {
        "followup_msg": "LAST_BOT_MSG"
      }
    },
    {
      "name": "追问 — 引用「追问回复」可继续追问（连续追问）",
      "preserve_followup": true,
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 55555,
        "raw_message": "那第二次追问呢？",
        "message": [
          {
            "type": "reply",
            "data": {
              "id": "$followup_msg"
            }
          },
          {
            "type": "text",
            "data": {
              "text": "那第二次追问呢？"
            }
          }
        ],
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "结论",
        "api_actions_include": "send_group_msg"
      }
    },
    {
      "name": "追问 — 引用无关消息不响应",
      "preserve_followup": true,
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 55555,
        "raw_message": "那怎么办？",
        "message": [
          {
            "type": "reply",
            "data": {
              "id": "999999999"
            }
          },
          {
            "type": "text",
            "data": {
              "text": "那怎么办？"
            }
          }
        ],
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "api_count": 0
      }
    },
    {
      "name": "追问答疑 — followup 可查看会话状态",
      "preserve_followup": true,
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 90001,
        "raw_message": "/maa followup",
        "message": "/maa followup",
        "sender": {
          "user_id": 90001,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "追问答疑会话"
      }
    },
    {
      "name": "追问答疑 — close 结束会话",
      "preserve_followup": true,
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 90001,
        "raw_message": "/maa followup close",
        "message": "/maa followup close",
        "sender": {
          "user_id": 90001,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "reply_contains": "已结束追问会话"
      }
    },
    {
      "name": "会话结束后 — 即使引用也不再响应",
      "event": {
        "post_type": "message",
        "message_type": "group",
        "group_id": 111111,
        "user_id": 55555,
        "raw_message": "那怎么办？",
        "message": [
          {
            "type": "reply",
            "data": {
              "id": "$LAST_BOT_MSG"
            }
          },
          {
            "type": "text",
            "data": {
              "text": "那怎么办？"
            }
          }
        ],
        "sender": {
          "user_id": 55555,
          "role": "member"
        }
      },
      "assert": {
        "no_error": true,
        "api_count": 0
      }
    }
  ]
}
